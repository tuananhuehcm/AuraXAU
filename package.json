{
  "name": "auraxau",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "postinstall": "prisma generate",
    "format": "prettier --write src tests *.ts *.json *.mjs public/*.json public/sw.js README.md",
    "db:format": "prisma format"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "decimal.js": "^10.6.0",
    "exceljs": "^4.4.0",
    "google-auth-library": "^10.5.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.8.3",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.10.1",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "type": "module",
